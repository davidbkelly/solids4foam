FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     Test-circulation1DPorts;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.6;
deltaT          5e-4;          // the 3D time step

writeControl    runTime;
writeInterval   10;

coupling
{
    scheme      implicit;       // explicit | implicit
    order       2;              // 1..4
    nIter       100;
    tolerance   1e-12;
}

