FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          circulation1DProperties;
}

fluid
{
    rho             1050;
    mu              0;
    profileOrder    9;
    alpha           1;
}

numerics
{
    CFL             0.5;
    flux            HLL;
    limiter         none;
    timeScheme      SSPRK2;
}

vessels
{
    tube
    {
        length          3;
        nCells          24000;
        radiusProximal  0.012;
        radiusDistal    0.006;
        wallThickness   0.0015;
        youngsModulus   400000;
        initialPressure 0;
    }
}

nodes
{
    inlet
    {
        type            flowInlet;
        connection      tube.in;
        flowRate
        {
            type            expression;
            expression      #{ 1e-9*exp(-1e4*sqr(arg() - 0.05)) #};
        }
    }
    outlet
    {
        type            absorbing;
        connection      tube.out;
    }
}


