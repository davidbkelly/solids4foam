FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// One output interval: pure CFL steps, the last one shortened to land on
// t = 0.4 s, when the pulse is centred near x = 2.2 m

application     circulation1DFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.4;
deltaT          0.4;          // output interval; the solver sub-steps at its CFL step

writeControl    runTime;
writeInterval   0.4;    // profiles and restart state

writePrecision  8;
timePrecision   6;

// ************************************************************************* //
