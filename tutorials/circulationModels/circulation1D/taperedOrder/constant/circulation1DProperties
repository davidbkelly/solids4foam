FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      circulation1DProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Order of accuracy of the scheme for a vessel with varying properties: a
// small (linear) Gaussian pulse in a 3 m vessel tapering 2:1 in radius,
// refined at fixed CFL with the unlimited reconstruction. There is no closed
// form, so the orders come from the differences between successive meshes.
// Allrun sets nCells of each run.

fluid
{
    rho             1050;
    mu              0;
    profileOrder    9;
    alpha           1;
}

numerics
{
    CFL             0.5;
    flux            HLL;
    limiter         none;
    timeScheme      SSPRK2;
}

vessels
{
    tube
    {
        length              3;
        nCells              1000;
        radiusProximal      0.012;
        radiusDistal        0.006;
        wallThickness       1.5e-3;
        youngsModulus       400e3;
        initialPressure     0;
    }
}

nodes
{
    inlet
    {
        type        flowInlet;
        connection  tube.in;
        flowRate                        // Boileau Eq. 14 scaled by 1e-3: linear
        {
            type        expression;
            expression  #{ 1e-9*exp(-1e4*sqr(arg() - 0.05)) #};
        }
    }

    outlet
    {
        type        absorbing;
        connection  tube.out;
    }
}

