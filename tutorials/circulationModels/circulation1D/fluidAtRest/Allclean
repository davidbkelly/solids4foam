#!/bin/bash
# Remove the results of the two variants
cd "$(dirname "$0")" || exit 1
for variant in atDiastolicPressure atLowerPressure; do
    (
        cd "$variant" || exit 0
        rm -rf postProcessing
        find . -maxdepth 1 -type d -regex './[0-9][0-9.e+-]*' -exec rm -rf {} +
        rm -f log log.*
    )
done
rm -f rest.md
