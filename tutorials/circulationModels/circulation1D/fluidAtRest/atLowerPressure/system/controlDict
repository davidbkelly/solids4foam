FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 2 s of rest (about 20000 steps); profiles every 0.5 s

application     circulation1DFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         2;
deltaT          1e-3;          // output interval; the solver sub-steps at its CFL step

writeControl    runTime;
writeInterval   0.5;    // profiles and restart state

writePrecision  8;
timePrecision   6;

// ************************************************************************* //
