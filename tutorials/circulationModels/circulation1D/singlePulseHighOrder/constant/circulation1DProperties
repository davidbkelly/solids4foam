FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      circulation1DProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Order of accuracy of the higher-order 1D scheme: the single pulse of
// singlePulseInviscid (full amplitude), refined at fixed CFL, each run against
// the finest run of its own set (self-convergence). Allrun sets, for each set,
// the reconstruction (MUSCL or kExact with its polynomialOrder), the time
// scheme, the viscosity and nCells.

fluid
{
    rho             1050;
    mu              0;
    profileOrder    9;
    alpha           1;
}

numerics
{
    CFL             0.5;
    flux            HLL;
    reconstruction  MUSCL;          // MUSCL | kExact
    polynomialOrder 2;              // kExact: order polynomialOrder + 1
    limiter         none;           // MUSCL only
    timeScheme      SSPRK2;         // SSPRK2 | SSPRK3 | RK4
}

vessels
{
    tube
    {
        length              10;
        nCells              1000;
        radius              0.01;
        wallThickness       1.5e-3;
        youngsModulus       400e3;
        initialPressure     0;
    }
}

nodes
{
    inlet
    {
        type        flowInlet;
        connection  tube.in;
        flowRate
        {
            type        scale;
            scale       1;              // amplitude factor
            value
            {
                type        expression;
                expression  #{ 1e-6*exp(-1e4*sqr(arg() - 0.05)) #};
            }
        }
    }

    outlet
    {
        type        absorbing;
        connection  tube.out;
    }
}

