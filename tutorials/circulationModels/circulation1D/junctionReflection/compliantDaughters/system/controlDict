FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The reflected pulse passes the parent probe at about 1.0 s. Probe rows
// every 0.1 ms to resolve the peaks.

application     circulation1DFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1.2;
deltaT          1e-4;          // output interval; the solver sub-steps at its CFL step

writeControl    runTime;
writeInterval   1.2;    // profiles and restart state

writePrecision  8;
timePrecision   6;

