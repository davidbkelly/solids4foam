FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 18 cardiac cycles of T = 0.827 s from rest; the in vitro windows of the
// supplement end by 15.03 s. Probe rows at 1 kHz, like the in vitro data.

application     circulation1DFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         15.1;
deltaT          1e-3;          // output interval; the solver sub-steps at its CFL step

writeControl    runTime;
writeInterval   0.827;    // profiles and restart state

writePrecision  8;
timePrecision   6;

// ************************************************************************* //
