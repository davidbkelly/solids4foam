FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 10 cardiac cycles of T = 1 s from (A0, 0, P0), as in the data supplement; the
// comparisons use the last one. Probe rows at 1 kHz.

application     circulation1DFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         10;
deltaT          1e-3;          // output interval; the solver sub-steps at its CFL step

writeControl    runTime;
writeInterval   1;    // profiles and restart state

writePrecision  8;
timePrecision   6;

// ************************************************************************* //
