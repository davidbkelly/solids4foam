FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The pulse reaches x = 9 m at t = 1.51 s; profiles every 0.1 s (Fig. 2 uses
// t = 0.1, 0.3, ..., 1.5 s)

application     circulation1DFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1.6;
deltaT          1e-3;          // output interval; the solver sub-steps at its CFL step

writeControl    runTime;
writeInterval   0.1;    // profiles and restart state

writePrecision  8;
timePrecision   6;

// ************************************************************************* //
