FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 20+ cardiac cycles of T = 0.9550 s from rest, as in the data supplement; the
// metrics use the last whole cycle. Probe rows at 1 kHz, like the 3D data.

application     circulation1DFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         20;
deltaT          1e-3;          // output interval; the solver sub-steps at its CFL step

writeControl    runTime;
writeInterval   0.9550;    // profiles and restart state

writePrecision  8;
timePrecision   6;

// ************************************************************************* //
