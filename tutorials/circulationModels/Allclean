#!/bin/bash
# Remove the results of every tutorial: circulation0D (0D circuits and their
# coupling to CFD), circulation1D (1D vessels) and coupling3D1D (3D-1D
# coupling). Case set-up files are never
# touched.
cd "$(dirname "$0")" || exit 1

for script in */Allclean; do
    [ -x "$script" ] && "./$script"
done
