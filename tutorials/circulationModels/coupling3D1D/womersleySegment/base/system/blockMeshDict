FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// Axisymmetric wedge (5 degrees) of a rigid pipe, radius R = 1 cm, length
// 10 cm, axis along z; 50 radial cells graded towards the wall (the Stokes
// layer is 1.2 mm thick at alpha = 12), 100 axial cells. The coupled ports
// use flowScale 72 (= 360/5) to recover the flow of the whole pipe.

scale 1;

R   0.01;
L   0.1;
// The flat outer face at the distance R from the axis (Rc = R, Rs = R tan(2.5 deg)):
// with flowScale pi/tan(theta/2) the discrete problem is the circular pipe
// of radius R exactly (see makeCases.py)
Rc  0.01;
Rs  0.000436609429;
nRs -0.000436609429;

vertices
(
    (0 0 0)
    ($Rc $nRs 0)
    ($Rc $Rs 0)
    (0 0 $L)
    ($Rc $nRs $L)
    ($Rc $Rs $L)
);

blocks
(
    hex (0 1 2 0 3 4 5 3) (50 1 100) simpleGrading (0.1 1 1)
);

edges ();

boundary
(
    inlet  { type patch; faces ((0 2 1 0)); }
    outlet { type patch; faces ((3 4 5 3)); }
    wall   { type wall;  faces ((1 2 5 4)); }
    front  { type wedge; faces ((0 1 4 3)); }
    back   { type wedge; faces ((0 3 5 2)); }
);

