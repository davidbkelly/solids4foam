/*--------------------------------*- C++ -*----------------------------------*\
| solids4foam: solid mechanics and fluid-solid interaction simulations        |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // PCG: GAMG does not converge on this wedge (it runs to maxIter)
    "p|pFinal|pcorr|pcorrFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-12;
        relTol          0;
        maxIter         5000;
    }

    "(U|UFinal)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-12;
        relTol          0;
        maxIter         1000;
    }
}

// The implicit coupling re-integrates the 1D network in every outer
// iteration, with the flow of the previous one; residualControl ends the
// step once the pressure has converged. On this viscous, wall-graded mesh
// the outer loop diverges with the momentum predictor on (the unrelaxed
// segregated iteration at a cell diffusion number of about 35 near the
// wall), and converges without it, slowly: about 15 iterations to 1e-7,
// far below the time error of the step.
PIMPLE
{
    momentumPredictor       no;
    nOuterCorrectors        50;
    nCorrectors             2;
    nNonOrthogonalCorrectors 0;

    residualControl
    {
        p
        {
            tolerance       1e-7;
            relTol          0;
        }
    }
}

