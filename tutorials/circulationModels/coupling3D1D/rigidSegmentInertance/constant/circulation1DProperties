FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      circulation1DProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// A rigid 8 cm pipe between two compliant vessels: the 0D reduction of the
// rigid-segment 3D-1D benchmark (src/circulationModels/docs/BENCHMARKS3D1D.md).
// The vessels are those of the single pulse (Boileau et al. 2015, Table II):
// c0 = 6.17 m/s, so tau = length/(2 c0) = 6.5 ms, about the width of the
// Gaussian pulse (sigma = 7.1 ms). In the linear limit the pipe transmits a
// low-pass filtered pulse, tau dPt/dt + Pt = Pinc, and reflects Pinc - Pt.
// The inflow of Boileau Eq. 14 is scaled by 1e-3, so that the pulse is linear
// (at full amplitude it steepens: it arrives 0.2 ms early per metre).

fluid
{
    rho             1050;
    mu              0;
    profileOrder    9;
    alpha           1;
}

numerics
{
    CFL             0.5;
    flux            HLL;
    limiter         none;
    timeScheme      SSPRK2;
}

vesselDefaults
{
    length              2;
    nCells              1600;           // dx = 1.25 mm
    radius              0.01;
    wallThickness       1.5e-3;
    youngsModulus       400e3;
    diastolicPressure   0;
    externalPressure    0;
    initialPressure     0;
}

vessels
{
    proximal {}
    distal   {}
}

nodes
{
    inlet
    {
        type        flowInlet;
        connection  proximal.in;
        flowRate
        {
            type        scale;
            scale       1e-3;           // amplitude factor
            value
            {
                type        expression;
                expression  #{ 1e-6*exp(-1e4*sqr(arg() - 0.05)) #};
            }
        }
    }

    rigid
    {
        type        inertance;
        connections (proximal.out distal.in);
        length      0.08;
        radius      0.01;
        pressure    static;
    }

    outlet
    {
        type        absorbing;
        connection  distal.out;
    }
}

// The incident pulse passes proximalMid at 0.21 s and reaches the pipe at
// 0.37 s; the reflected and transmitted pulses reach the midpoints at 0.54 s
probes
{
    proximalMid { vessel proximal; x midpoint; }
    distalMid   { vessel distal;   x midpoint; }
}

