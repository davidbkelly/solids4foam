FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     circulation1DFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.6;

deltaT          0.6;

writeControl    runTime;

writeInterval   0.6;

writePrecision  10;

timePrecision   6;


