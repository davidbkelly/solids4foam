FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     rhoPimpleFoam;

// The 1D network and the coupler, built from src/circulationModels
libs            ("libcirculation1DCoupling.so");

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.35;
deltaT          4e-4;           // acoustic Courant c dt/dz = 0.49 at dz = 5 mm

adjustTimeStep  no;

writeControl    runTime;
writeInterval   0.35;           // the fields and the vessel profiles at the end

purgeWrite      0;
writeFormat     binary;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   12;

runTimeModifiable false;

// ************************************************************************* //
