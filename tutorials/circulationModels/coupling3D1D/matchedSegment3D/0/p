FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The pressure in Pa, relative to the vessels' reference pressure (0): the
// density is rho0 = 1050 kg/m^3 at p = 0

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // The coupling scheme and order are chosen in
    // constant/circulation1DProperties, not here
    inlet
    {
        type            circulation1DPressure;
        value           uniform 0;
    }

    outlet
    {
        type            circulation1DPressure;
        value           uniform 0;
    }

    wall
    {
        type            zeroGradient;
    }
}

