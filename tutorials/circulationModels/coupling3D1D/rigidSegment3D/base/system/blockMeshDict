FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// A rigid pipe of radius 1 cm and length 8 cm along z: an O-grid of
// 4*(4*8*16) + 8*8*16 = 3072 cells (pipeWindkessel's, scaled).
// The patches are polygons of 32 sides on the circle: area
// 32/2 R^2 sin(2 pi/32) = 3.1214451523e-04 m2, 0.64% below pi R^2. With slip walls
// the radial resolution does not matter.

scale 1;

vertices
(
    (0.01 0 0)
    (0 0.01 0)
    (-0.01 0 0)
    (0 -0.01 0)
    (0.01 0 0.08)
    (0 0.01 0.08)
    (-0.01 0 0.08)
    (0 -0.01 0.08)
    (0.003 0 0)
    (0 0.003 0)
    (-0.003 0 0)
    (0 -0.003 0)
    (0.003 0 0.08)
    (0 0.003 0.08)
    (-0.003 0 0.08)
    (0 -0.003 0.08)
);

blocks
(
    hex ( 8  0  1  9  12  4  5 13) (4 8 16) simpleGrading (1 1 1)
    hex ( 9  1  2 10  13  5  6 14) (4 8 16) simpleGrading (1 1 1)
    hex (10  2  3 11  14  6  7 15) (4 8 16) simpleGrading (1 1 1)
    hex (11  3  0  8  15  7  4 12) (4 8 16) simpleGrading (1 1 1)
    hex ( 8  9 10 11  12 13 14 15) (8 8 16) simpleGrading (1 1 1)
);

edges
(
    arc 0 1 ( 0.007071067812  0.007071067812 0)
    arc 1 2 (-0.007071067812  0.007071067812 0)
    arc 2 3 (-0.007071067812 -0.007071067812 0)
    arc 3 0 ( 0.007071067812 -0.007071067812 0)
    arc 4 5 ( 0.007071067812  0.007071067812 0.08)
    arc 5 6 (-0.007071067812  0.007071067812 0.08)
    arc 6 7 (-0.007071067812 -0.007071067812 0.08)
    arc 7 4 ( 0.007071067812 -0.007071067812 0.08)
);

boundary
(
    inlet                   // z = 0: fed by the proximal vessel
    {
        type patch;
        faces
        (
            ( 8  0  1  9)
            ( 9  1  2 10)
            (10  2  3 11)
            (11  3  0  8)
            ( 8  9 10 11)
        );
    }
    outlet                  // z = l: feeds the distal vessel
    {
        type patch;
        faces
        (
            (12  4  5 13)
            (13  5  6 14)
            (14  6  7 15)
            (15  7  4 12)
            (12 13 14 15)
        );
    }
    wall
    {
        type wall;
        faces
        (
            (0 4 5 1)
            (1 5 6 2)
            (2 6 7 3)
            (3 7 4 0)
        );
    }
);

mergePatchPairs
(
);

