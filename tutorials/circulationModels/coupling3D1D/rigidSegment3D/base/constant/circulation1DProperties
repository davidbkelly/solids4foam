FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      circulation1DProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The 1D side of the rigid-segment 3D-1D benchmark
// (src/circulationModels/docs/BENCHMARKS3D1D.md): two vessels of the single
// pulse (Boileau et al. 2015, Table II; c0 = 6.17 m/s), 1 m each, joined
// through the 3D pipe by two coupledFlow ports. The 3D pipe is rigid with slip
// walls, so its exact solution is plug flow: an inertance L = rho l/A3D, and in
// the linear limit tau dPt/dt + Pt = Pinc, tau = L/(2 Zc) = 6.52 ms. The inflow
// of Boileau Eq. 14 is scaled by 1e-3 so that the pulse is linear.

fluid
{
    rho             1050;
    mu              0;
    profileOrder    9;
    alpha           1;
}

// SSPRK3: its time error at CFL 0.5 (6e-6 of the peak) stays below the
// coupling error being measured; SSPRK2's (1e-3) would not
numerics
{
    CFL             0.5;
    flux            HLL;
    limiter         none;
    timeScheme      SSPRK3;
}

vesselDefaults
{
    length              1;
    nCells              800;            // dx = 1.25 mm
    radius              0.01;
    wallThickness       1.5e-3;
    youngsModulus       400e3;
    diastolicPressure   0;
    externalPressure    0;
    initialPressure     0;
}

vessels
{
    proximal {}
    distal   {}
}

nodes
{
    inlet
    {
        type        flowInlet;
        connection  proximal.in;
        flowRate
        {
            type        scale;
            scale       1e-3;           // amplitude factor
            value
            {
                type        expression;
                expression  #{ 1e-6*exp(-1e4*sqr(arg() - 0.05)) #};
            }
        }
    }

    to3D                                // feeds the 3D inlet
    {
        type        coupledFlow;
        connection  proximal.out;
        patch       inlet;
    }

    from3D                              // fed by the 3D outlet
    {
        type        coupledFlow;
        connection  distal.in;
        patch       outlet;
    }

    outlet
    {
        type        absorbing;
        connection  distal.out;
    }
}

// The incident pulse passes proximalMid at 0.13 s and reaches the pipe at
// 0.21 s; the reflected and transmitted pulses reach the midpoints at 0.29 s
probes
{
    proximalMid { vessel proximal; x midpoint; }
    distalMid   { vessel distal;   x midpoint; }
}

coupling
{
    scheme      implicit;       // explicit | implicit
    order       2;              // 1..4
    seed        zero;           // at rest: every earlier flow is zero
}

